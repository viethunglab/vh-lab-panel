{
  "manifestVersion": 5,
  "id": "com.viethunglabs.vhlabpanel",
  "name": "VH Lab Panel",
  "version": "4.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "vhlab",
      "label": { "default": "VH Lab" },
      "minimumSize": { "width": 265, "height": 300 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 275, "height": 520 },
      "preferredFloatingSize": { "width": 275, "height": 520 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["chrome"] }
      ]
    }
  ],
  "icons": [
    { "width": 23, "height": 23, "path": "icons/icon.png", "scale": [1, 2], "theme": ["all"], "species": ["generic"] }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": ["file", "https"],
      "extensions": [".exe", ".app"]
    }
  }
}
